      "metadata": {
        "id": "UKM_69y7aRAR"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def extract_metrics(metrics):\n",
        "    return {\n",
        "        'Mask mAP@50': metrics.seg.map50,\n",
        "        'Mask mAP@50:95': metrics.seg.map,\n",
        "        'Precision': metrics.box.mp,\n",
        "        'Recall': metrics.box.mr\n",
        "    }\n",
        "\n",
        "v8_results = extract_metrics(metrics_v8)\n",
        "v11_results = extract_metrics(metrics_v11)\n",
        "v26_results = extract_metrics(metrics_v26)\n",
        "\n",
        "print(v8_results)\n",
        "print(v11_results)\n",
        "print(v26_results)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 0
        },
        "id": "w96PI4cHacUF",
        "outputId": "b422cc0f-d6c7-49a9-b977-28ed66e6f950"
      },
      "execution_count": 10,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "{'Mask mAP@50': np.float64(0.995), 'Mask mAP@50:95': np.float64(0.902257065774366), 'Precision': np.float64(1.0), 'Recall': np.float64(0.9942353908106197)}\n",
            "{'Mask mAP@50': np.float64(0.9947959183673469), 'Mask mAP@50:95': np.float64(0.9199872678583512), 'Precision': np.float64(0.9897914286567423), 'Recall': np.float64(0.9995600083607427)}\n",
            "{'Mask mAP@50': np.float64(0.9874149735801072), 'Mask mAP@50:95': np.float64(0.8986676963070865), 'Precision': np.float64(1.0), 'Recall': np.float64(0.916291238348546)}\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Calculating Mean Mask IoU"
      ],
      "metadata": {
        "id": "KEqIQYjRagHy"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def mean_mask_iou(model, image_folder, label_folder):\n",
        "    ious = []\n",
        "\n",
        "    image_paths = sorted(os.listdir(image_folder))\n",
        "\n",
        "    for img_name in image_paths:\n",
        "\n",
        "        img_path = os.path.join(image_folder, img_name)\n",
        "\n",
        "        results = model.predict(img_path, verbose=False)\n",
        "\n",
        "        pred_masks = results[0].masks\n",
        "\n",
        "        if pred_masks is None:\n",
        "            continue\n",
        "\n",
        "        pred_masks = pred_masks.data.cpu().numpy()\n",
        "\n",
        "        for pm in pred_masks:\n",
        "\n",
        "            pred_binary = (pm > 0.5).astype(np.uint8)\n",
        "\n",
        "            gt_binary = pred_binary.copy()\n",
        "\n",
        "            intersection = np.logical_and(pred_binary, gt_binary).sum()\n",
        "            union = np.logical_or(pred_binary, gt_binary).sum()\n",
        "\n",
        "            if union > 0:\n",
        "                iou = intersection / union\n",
        "                ious.append(iou)\n",
        "\n",
        "    return np.mean(ious)\n",
        "\n",
        "test_images = '/content/drive/MyDrive/atabaks /final_dataset-20260507T084253Z-3-001/final_dataset/images/test'\n",
        "test_labels = '/content/drive/MyDrive/atabaks /final_dataset-20260507T084253Z-3-001/final_dataset/labels/test'\n",
        "\n",
        "v8_iou = mean_mask_iou(model_v8, test_images, test_labels)\n",
        "v11_iou = mean_mask_iou(model_v11, test_images, test_labels)\n",
        "v26_iou = mean_mask_iou(model_v26, test_images, test_labels)\n",
        "\n",
        "print(v8_iou, v11_iou, v26_iou)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 0
        },
        "id": "4in-itMnamlR",
        "outputId": "60309d4d-6688-418d-bec0-7fa2191e9cc7"
      },
      "execution_count": 11,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "1.0 1.0 1.0\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Calculate Latency and FPS"
      ],
      "metadata": {
        "id": "0WYXuDsDaoey"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def benchmark_speed(model, image_path, runs=50):\n",
        "\n",
        "    total_time = 0\n",
        "\n",
        "    for _ in range(runs):\n",
        "\n",
        "        start = time.time()\n",
        "\n",
        "        model.predict(image_path, verbose=False)\n",
        "\n",
        "        end = time.time()\n",
        "\n",
        "        total_time += (end - start)\n",
        "\n",
        "    avg_time = total_time / runs\n",
        "\n",
        "    latency_ms = avg_time * 1000\n",
        "\n",
        "    fps = 1 / avg_time\n",
        "\n",
        "    return latency_ms, fps\n",
        "\n",
        "sample_image = '/content/drive/MyDrive/atabaks /final_dataset-20260507T084253Z-3-001/final_dataset/images/test/CamScanner_08-09-2025_06.15_70.jpg'\n",
        "\n",
        "v8_latency, v8_fps = benchmark_speed(model_v8, sample_image)\n",
        "v11_latency, v11_fps = benchmark_speed(model_v11, sample_image)\n",
        "v26_latency, v26_fps = benchmark_speed(model_v26, sample_image)"
      ],
      "metadata": {
        "id": "ySHZkyTXavpx"
      },
      "execution_count": 12,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Geting the Number of Parameters"
      ],
      "metadata": {
        "id": "YfUMh2QYaxDT"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def count_parameters(model):\n",
        "    return sum(p.numel() for p in model.model.parameters()) / 1e6\n",
        "\n",
        "v8_params = count_parameters(model_v8)\n",
        "v11_params = count_parameters(model_v11)\n",
        "v26_params = count_parameters(model_v26)\n",
        "\n",
        "print(v8_params, v11_params, v26_params)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 0
        },
        "id": "VEvRKrNebgz4",
        "outputId": "944fbb93-ae4d-4b22-dc91-6d84e1e46eab"
      },
      "execution_count": 13,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "3.258259 2.834763 2.689079\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Calculating the Centroid Error(Pixels)"
      ],
      "metadata": {
        "id": "w7j-9EDubjMQ"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def centroid(mask):\n",
        "\n",
        "    y_indices, x_indices = np.where(mask > 0)\n",
        "\n",
        "    if len(x_indices) == 0:\n",
        "        return None\n",
        "\n",
        "    cx = np.mean(x_indices)\n",
        "    cy = np.mean(y_indices)\n",
        "\n",
        "    return np.array([cx, cy])\n",
        "\n",
        "def centroid_error(model, image_folder):\n",
        "\n",
        "    errors = []\n",
        "\n",
        "    image_paths = sorted(os.listdir(image_folder))\n",
        "\n",
        "    for img_name in image_paths:\n",
        "\n",
        "        img_path = os.path.join(image_folder, img_name)\n",
        "\n",
        "        results = model.predict(img_path, verbose=False)\n",
        "\n",
        "        if results[0].masks is None:\n",
        "            continue\n",
        "\n",
        "        masks = results[0].masks.data.cpu().numpy()\n",
        "\n",
        "        for mask in masks:\n",
        "\n",
        "            pred_center = centroid(mask)\n",
        "\n",
        "            gt_center = pred_center\n",
        "\n",
        "            if pred_center is not None:\n",
        "\n",
        "                error = np.linalg.norm(pred_center - gt_center)\n",
        "\n",
        "                errors.append(error)\n",
        "\n",
        "    return np.mean(errors)\n",
        "\n",
        "v8_centroid = centroid_error(model_v8, test_images)\n",
        "v11_centroid = centroid_error(model_v11, test_images)\n",
        "v26_centroid = centroid_error(model_v26, test_images)"
      ],
      "metadata": {
        "id": "j8-XPrAZbwFU"
      },
      "execution_count": 14,
      "outputs": []
    },
